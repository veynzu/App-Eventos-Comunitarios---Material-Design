rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validFolder(folder) {
      return folder in ['profiles', 'events', 'identities'];
    }

    function isModerator() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRATOR'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountStatus == 'ACTIVE';
    }

    function ownsFolder(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /{folder}/{uid}/{fileName} {
      // Permite consultar fotos de perfiles y eventos desde la app.
      allow get: if validFolder(folder) && signedIn()
        && (folder != 'identities' || ownsFolder(uid) || isModerator());

      // FirebaseMediaRepository genera un UUID nuevo para cada imagen.
      allow create: if validFolder(folder)
        && ownsFolder(uid)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && 'ownerId' in request.resource.metadata
        && request.resource.metadata.ownerId == uid;

      // Separar delete evita validar tamaño o tipo de un archivo inexistente.
      allow delete: if validFolder(folder) && ownsFolder(uid);
    }

    match /event-drafts/{uid}/{fileName} {
      allow get, delete: if ownsFolder(uid);
      allow create: if ownsFolder(uid) && resource == null
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.ownerId == uid;
    }

    match /validated-events/{uid}/{fileName} {
      allow get: if signedIn();
      // Solo Functions crea esta copia de los bytes analizados. Un cliente no puede reemplazarla.
      allow delete: if ownsFolder(uid) || isModerator();
    }

    // Listados, sobrescrituras y otras rutas quedan denegados por defecto.
  }
}
